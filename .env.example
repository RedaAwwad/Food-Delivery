# Server Configuration
PORT=3000
APP_BASE_URL=http://localhost:4000
API_VERSION=v1
NODE_ENV=development
ENVIRONMENT=dev

# Database
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@localhost:${DATABASE_LOCAL_PORT}/${DATABASE_NAME}?schema=public
DATABASE_PORT=5432
DATABASE_LOCAL_PORT=5433
DATABASE_NAME=food-delivery
DATABASE_USER=postgres
DATABASE_PASSWORD=test

# JWT Secrets
JWT_SECRET=b291703a2eeccba9d5b6a57d2f982b257c43ab6380226d030e17532bac3eb4a7
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this
TOKEN_KEY=your-super-secret-token-key-change-this

# Token Expiry
ACCESS_TOKEN_EXPIRY=30d
REFRESH_TOKEN_EXPIRY=90d
GENERAL_TOKEN_EXPIRY=1d

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in milliseconds
PASSWORD_RESET_URL=http://localhost:4000/api/v1/auth/reset-password  # Frontend URL for reset page

# Verify Email
EMAIL_VERIFICATION_URL=http://localhost:4000/api/v1/auth/verify-email  # Frontend URL for email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400000  # 24 hours in milliseconds

# Email Service (Optional - will log to console if not configured)
# Enable 2FA and generate app password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Alternative Email Providers:
# SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

# Mailgun:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USER=your-mailgun-smtp-username
# EMAIL_PASSWORD=your-mailgun-smtp-password

# Security
SALT_ROUNDS=10